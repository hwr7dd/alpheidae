# BlitzOS guest kernel — minimal Firecracker config fragment.
# Apply on top of `make tinyconfig` (x86_64). Target: <5 MB vmlinux,
# <50 ms first boot. First boot only happens ONCE (golden snapshot
# creation); the query path is snapshot resume and never boots this kernel.
#
#   make tinyconfig
#   ./scripts/kconfig/merge_config.sh .config blitzos.config
#   make vmlinux -j$(nproc)

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Virtio over MMIO — the only device model Firecracker exposes
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Filesystems: ext4 (read-only rootfs), proc, sysfs, tmpfs, devtmpfs
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking (worker<->coordinator data plane)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y

# Hugepages: back guest memory with 2M pages → faster snapshot resume
# (fewer page faults on the memory file restore path)
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# Everything else: OFF. No modules, no USB, no PCI, no ACPI bloat,
# no graphics, no sound, no kprobes.
# CONFIG_MODULES is not set
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set

# Scheduler/timer: tickless for clean pause/resume
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Boot args used with this kernel (see make_snapshot.sh):
#   console=ttyS0 reboot=k panic=1 pci=off quiet
#   init=/blitz-init blitz.role=worker blitz.coord=10.0.0.1:7311
